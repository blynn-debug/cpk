# cpk 환경 설정 예시. 맥미니 ~/cpk/cpk.env 로 복사해 값을 채운다(cpk.env 는 .gitignore).
# install_mac.sh 가 cpk.env가 없을 때 이 예시에서 생성한다.
# 예약 수집/검색 헬스체크 없음. 검색은 사용자 요청으로만 실행한다.

# 실행 경로 선택 -------------------------------------------------
# 검색을 실제 Chrome(CDP)으로 한다. python 은 curl_cffi 직접(현재 아카마이에 자주 막힘).
CPK_COLLECT_MODE=browser
# 검색 진입: ui(홈 검색창 입력·제출) 권장 — url 직접 이동은 error403으로 자주 막힌다(2026-09-17 관측).
# 주의: ui 는 검색당 홈+검색 2요청이라 url 보다 예산을 2배 쓴다(대량이면 CPK_DAILY_BUDGET 상향).
CPK_SEARCH_MODE=ui
# 1이면 검색마다 깨끗한 시크릿(격리 컨텍스트)을 새로 열어 개인화 오염을 막는다.
# 오염 실측: 한 프로필 누적 시 대상 검색어 top10 겹침 80%→50%로 흔들림(2026-09-17). 격리하면 안정.
# 주의: cold 컨텍스트라 검색마다 홈 워밍업이 강제돼 요청 예산을 url 단독보다 더 쓴다(≈2요청/검색).
CPK_FRESH_CONTEXT=1

# 요청 제어(모든 경로 공유) ------------------------------------
# 검색 사이 최소 간격(초). 동시 검색 금지와 함께 요청 관문이 강제한다.
CPK_SEARCH_MIN_GAP=20
# 하루 총 관문 요청 예산(검색·자동완성·워밍업·재시도 합산). 키워드 개수가 아니다.
CPK_DAILY_BUDGET=300
# 명확한 차단(챌린지·403·429) 시 공통 중단 시간(시간).
CPK_BACKOFF_HOURS=6
# 수집 검색어 사이 무작위 간격(초).
CPK_COLLECT_GAP_MIN=25
CPK_COLLECT_GAP_MAX=60
# 사용자 요청 시각에 일괄 수집 가능. 필요하면 "02-06" 같은 제외 시간대를 명시한다.
CPK_QUIET_HOURS=

# 결과 동기화 --------------------------------------------------
# 수집 결과를 rsync 로 보낼 대상. 비우면 동기화 안 함.
CPK_SYNC_TARGET=aws103:cpk-data/

# 알림(선택) --------------------------------------------------
# ntfy 토픽. 채우면 연속 실패 시 알림. 비우면 알림 생략.
CPK_NTFY_TOPIC=

# 참고/보조 --------------------------------------------------
# python 경로에서만 의미: 세션 실패 시 브라우저 자동 재발급(1=on).
CPK_AUTO_REISSUE=1
# 프록시(주거용 권장) -----------------------------------------
# CPK_PROXY 를 채우면 검색마다 그 프록시로 라우팅되는 새 시크릿 컨텍스트로 돈다(브라우저 경로 지원).
# 상시 Chrome 본체는 직결 유지되고, 검색 컨텍스트만 프록시를 탄다. IP 분산으로 한 IP가 타는 걸 막는다.
# 형식: scheme://user:pass@host:port  또는  host:port (+ CPK_PROXY_USER/PASS). 자격증명은 CDP로 인증.
# 자격증명이 없으면(IP 화이트리스트 방식) 프록시 대시보드에서 집 공인 IP를 등록해야 한다.
# 대역폭 절약: 프록시 경로에서 이미지·미디어·폰트를 차단한다(파싱엔 HTML만 필요). 끄려면 0.
# CPK_PROXY=
# CPK_PROXY_USER=
# CPK_PROXY_PASS=
CPK_PROXY_BLOCK_MEDIA=1
# Chrome 실행 파일·디버그 포트(기본값이 맞으면 비워둔다).
# CPK_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CPK_CDP_PORT=9222
