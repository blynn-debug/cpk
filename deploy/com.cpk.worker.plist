<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.cpk.worker</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>__HOME__/cpk/deploy/run_worker.sh</string></array>
  <key>WorkingDirectory</key><string>__HOME__/cpk</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>70</integer>
  <key>StandardOutPath</key><string>__HOME__/cpk/state/worker.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/cpk/state/worker.err.log</string>
</dict></plist>
