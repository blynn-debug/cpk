<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cpk.market</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd __HOME__/cpk &amp;&amp; set -a; . ./cpk.env 2>/dev/null; set +a; exec .venv/bin/python cpk_market_collect.py</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>20</integer>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/cpk/state/market.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/cpk/state/market.err.log</string>
</dict>
</plist>
